# --------------------------------------------------------------------
*.log
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
.pids
*.pid
*.seed
*.pid.lock

# --------------------------------------------------------------------
# SECURITY & CREDENTIALS (CRITICAL!)
# --------------------------------------------------------------------
# Always ignore local configuration files containing passwords/API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.crt
*.key
*.pfx
*.p12
credentials.json
secrets.json
auth.json

# --------------------------------------------------------------------
# COMPILER / BUILD OUTPUT & BUNDLERS
# --------------------------------------------------------------------
.next/
.nuxt/
.vuepress/dist
.serverless/
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/

# --------------------------------------------------------------------
# DOCKER & VIRTUALIZATION
# --------------------------------------------------------------------
.docker/
docker-compose.override.yml

