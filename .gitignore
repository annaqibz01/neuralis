*.iwb
*.iml
*.iws
out/

# Eclipse
.metadata/
bin/
tmp/
*.tmp
*.bak
*.class
.classpath
.project
.settings/

# Sublime Text & TextMate
*.sublime-project
*.sublime-workspace
.textmate_init

# Vim / Emacs
*~
*.swp
*.swo
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-v][a-z]
[._]ss[a-z]

