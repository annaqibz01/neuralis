# --------------------------------------------------------------------
# OPERATING SYSTEM (OS SPECIFIC)
# --------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon_
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.fuse_hidden*
.xdg-volume-info
.trash
.crumbs

# --------------------------------------------------------------------
# IDEs AND EDITORS (EDITORS & IDEs)
# --------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ, WebStorm, PyCharm, PhpStorm, etc.)
