{
  "name": "neuralis",
  "displayName": "Neuralis",
  "description": "DeepSeek-optimized AI coding assistant featuring high-efficiency context caching and structured reasoning token stream parsing.",
  "version": "1.2.1",
  "publisher": "annaqibz01",
  "icon": "icon.svg",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Neuralis Settings",
      "properties": {
        "neuralis.apiKey": {
          "type": "string",
          "default": "",
          "description": "Enter your official DeepSeek API key."
        },
        "neuralis.model": {
          "type": "string",
          "enum": [
            "deepseek-chat",
            "deepseek-reasoning"
          ],
          "default": "deepseek-chat",
          "description": "Select the target model: deepseek-chat (v4 Flash) or deepseek-reasoning (Pro)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neuralis-sidebar-container",
          "title": "Neuralis",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "neuralis-sidebar-container": [
        {
          "type": "webview",
          "id": "neuralis.sidebar",
          "name": "Neuralis Chat Room"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3"
  }
}
